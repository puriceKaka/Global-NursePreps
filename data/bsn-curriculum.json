    {
      "id": "bsn-year-1",
      "title": "BSN Year 1: Nursing Foundations",
      "yearLabel": "1st Year",
      "description": "First-year BSN learning path covering core sciences, nursing foundations, communication, and early clinical thinking.",
      "totalHours": 96,
      "terms": [
        {
          "name": "Term 1",
          "modules": [
            {
              "title": "Introduction to Nursing Profession",
              "objectives": [
                "Understand the history and evolution of nursing",
                "Identify nursing roles and responsibilities",
                "Apply nursing ethics and professional standards"
              ],
              "topics": [
                "History of Nursing",
                "Nursing as a Profession",
                "Nursing Ethics and Legal Aspects",
                "Nursing Theories and Models",
                "Healthcare Systems Overview"
              ],
              "estimatedHours": 12
            },
            {
              "title": "Anatomy and Physiology I",
              "objectives": [
                "Describe the structure and function of body systems",
                "Understand homeostasis and feedback mechanisms",
                "Apply anatomical terminology"
              ],
              "topics": [
                "Anatomical Terminology and Body Planes",
                "Cell Structure and Function",
                "Tissues and Membranes",
                "Integumentary System",
                "Skeletal System",
                "Muscular System"
              ],
              "estimatedHours": 16
            },
            {
              "title": "Foundations of Nursing Practice",
              "objectives": [
                "Demonstrate basic nursing skills",
                "Apply infection control principles",
                "Perform vital signs assessment"
              ],
              "topics": [
                "Basic Nursing Skills",
                "Infection Prevention and Control",
                "Vital Signs Assessment",
                "Patient Hygiene and Comfort",
                "Body Mechanics and Positioning",
                "Documentation and Reporting"
              ],
              "estimatedHours": 14
            },
            {
