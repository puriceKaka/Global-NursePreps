# Firebase Admin SDK (server-side)
# Create a service account in Firebase console and set these values.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-service-account-email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# Production security
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
CORS_ORIGIN=https://puricekaka.github.io

# Future SQL database
DATABASE_URL=postgresql://user:password@host:5432/global_nurseprep

# Optional: enable Firestore persistence later
# (No client SDK is wired yet; this repo still uses localStorage by default.)

